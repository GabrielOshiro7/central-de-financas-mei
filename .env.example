# Connection string do Postgres.
# Para o Postgres local via docker-compose (docker-compose.yml na raiz do projeto):
DATABASE_URL="postgresql://app:app_dev_password@localhost:5432/app_db?schema=public"

# Base URL da aplicacao (usada para montar o link de recuperacao de senha)
APP_URL="http://localhost:3000"

# Ambiente: em "development" o EmailService apenas loga o link no console.
NODE_ENV="development"
