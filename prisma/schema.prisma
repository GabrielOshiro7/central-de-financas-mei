generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ThemePreference {
  LIGHT
  DARK

  @@map("theme_preference")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Tema escolhido pelo usuario (claro/escuro). NULL = sem escolha salva => claro
  // (o padrao do app). O servidor renderiza o tema pelo cookie "theme"; esta coluna
  // so leva a escolha para outro navegador/dispositivo (aplicada no login).
  themePreference ThemePreference? @map("theme_preference")

  // Aceite dos Termos de Servico e da Politica de Privacidade no cadastro: quando foi e
  // quais VERSOES (src/content/legal/meta.ts). NULL em quem se cadastrou antes desta
  // funcionalidade (a re-aceitacao dos usuarios existentes sera decidida depois).
  legalAcceptedAt DateTime? @map("legal_accepted_at")
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")

  sessions         Session[]
  insightReads     InsightRead[]
  resetTokens      PasswordResetToken[]
  business         Business?
  financialEntries FinancialEntry[]
  sales            Sale[]

  @@map("users")
}

enum BusinessType {
  RESTAURANTE
  LOJA
  SERVICOS
  CONSTRUCAO
  ECOMMERCE
  ACADEMIA
  OUTRO

  @@map("business_type")
}

enum YearsInBusiness {
  MENOS_DE_1_ANO
  DE_1_A_3_ANOS
  DE_3_A_5_ANOS
  DE_5_A_10_ANOS
  MAIS_DE_10_ANOS

  @@map("years_in_business")
}

enum Currency {
  JPY
  BRL
  USD

  @@map("currency")
}

enum FinancialEntryType {
  REVENUE
  COST
  EXPENSE

  @@map("financial_entry_type")
}

enum EntrySource {
  MANUAL
  IMPORT
  RECURRING
  BILL

  @@map("entry_source")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("recurrence_frequency")
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED

  @@map("bill_status")
}

// Pessoa fisica vs juridica - nunca assume que o cliente tem CPF/CNPJ
// (Etapa 6): o campo `document` em Client fica livre/opcional para cobrir
// clientes japoneses e de outros paises sem numero de documento equivalente.
enum ClientType {
  PESSOA_FISICA
  PESSOA_JURIDICA

  @@map("client_type")
}

// Estado COMERCIAL da venda - nunca confundir com status de pagamento
// (Etapa 6, ADENDO): pagamento e sempre DERIVADO dos Bills relacionados
// (ver deriveSalePaymentStatus em src/lib/sales/status.ts), nunca persistido
// aqui. DRAFT nao gera nenhum Bill/FinancialEntry - so CONFIRMED (via
// createSale direto ou confirmSale a partir de um DRAFT) materializa as
// parcelas. COMPLETED e um marcador comercial manual (ex.: entrega
// concluida) sem nenhum efeito financeiro.
enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("sale_status")
}

enum SaleDiscountType {
  FIXED
  PERCENTAGE

  @@map("sale_discount_type")
}

// Categorias de Insight (Etapa 7) - agrupam os cards na UI, nunca calculam
// nada por si so (ver InsightMetric abaixo pro conjunto fechado de metricas).
enum InsightCategory {
  PERFORMANCE
  PROFITABILITY
  CASH_FLOW
  CLIENTS
  SALES
  RECEIVABLES

  @@map("insight_category")
}

enum InsightPriority {
  INFO
  ATTENTION
  CRITICAL

  @@map("insight_priority")
}

// Conjunto FECHADO de metricas (Etapa 7) - src/lib/insights/rules.ts e um
// switch exaustivo sobre este enum (mesmo estilo de deriveBillStatus): uma
// metrica nova sem o case correspondente falha tsc, nunca fica inerte em
// silencio.
enum InsightMetric {
  REVENUE_GROWTH
  MARGIN_CHANGE
  EXPENSE_GROWTH
  TICKET_AVERAGE_CHANGE
  RECEIVABLES_OVERDUE_CHANGE
  CLIENT_CONCENTRATION
  CLIENT_INACTIVITY

  @@map("insight_metric")
}

// PERCENT: variacao relativa (ex.: receita cresceu 12%). POINTS: diferenca
// direta entre dois percentuais (ex.: margem caiu 4 pontos) - nunca usado
// para valores em moeda. Ver marginPointsDelta/calculateVariationPercent em
// src/lib/finance/calculations.ts, reaproveitados sem duplicacao.
enum VariationKind {
  PERCENT
  POINTS

  @@map("variation_kind")
}

// "Atrasado" nao entra aqui de proposito - nunca e persistido, sempre
// derivado em runtime (status PENDING + dueDate no passado). Ver
// deriveBillStatus em src/lib/finance/bills/status.ts.
enum RecurringBillFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY

  @@map("recurring_bill_frequency")
}

model Business {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                  String?
  businessType          BusinessType?    @map("business_type")
  revenueModel          String[]         @map("revenue_model")
  revenueModelOther     String?          @map("revenue_model_other")
  yearsInBusiness       YearsInBusiness? @map("years_in_business")
  employeeCount         Int?             @map("employee_count")
  // Nunca inferida por locale/navegador/header - sempre escolha explicita do
  // usuario no onboarding (ou editada na secao "Empresa" de Configuracoes,
  // Etapa 5.1 - antes era a pagina /empresa). Default BRL so serve
  // para linhas que ja existiam antes desse campo virar obrigatorio (ver
  // migration) e para negocios que ainda nao terminaram o onboarding.
  // Trocar depois de a empresa ja ter lancamentos e bloqueado na API (secao
  // "Bug 1" da Etapa 3.1) - nesta etapa nao ha conversao/cambio retroativo.
  currency              Currency         @default(BRL)
  averageMonthlyRevenue Decimal?         @map("average_monthly_revenue") @db.Decimal(14, 2)

  // Caixa (Etapa 5.1): posicao de caixa = openingBalance + soma do netProfit
  // de todos os FinancialEntry com occurredOn ESTRITAMENTE POSTERIOR a
  // openingBalanceOn (ver calculateAccumulatedBalance em
  // src/lib/finance/cash/calculations.ts). Editado no mesmo formulario/lugar
  // de currency (secao "Empresa" de Configuracoes), nao no onboarding.
  // openingBalanceOn nulo = "nao configurado" - a UI usa o dia do
  // primeiro FinancialEntry como base implicita (saldo inicial = 0 nesse
  // dia) e sinaliza isso com um banner, nunca finge que foi configurado.
  // Dia de calendario (@db.Date, Etapa F6; sufixo _on = dia, _at = instante).
  openingBalance   Decimal   @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceOn DateTime? @db.Date @map("opening_balance_on")

  // Fuso da EMPRESA (Etapa F2 do plano de fuso): pais ISO 3166-1 alfa-2 e
  // fuso IANA. Default JP/Asia/Tokyo para as linhas existentes e para toda
  // empresa nova (o onboarding nao pergunta ainda - Decisao pendente 1).
  // Validados por src/lib/time/schema.ts; o relogio da empresa sai de
  // getBusinessClock (src/lib/time/businessClock.ts). Ninguem le estes campos
  // ainda: os chamadores passam a usa-los na F3.
  country  String @default("JP") @map("country")
  timezone String @default("Asia/Tokyo") @map("timezone")

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep      Int     @default(1) @map("onboarding_step")

  // Contador para numeracao sequencial de vendas (Etapa 6, "Venda #1025").
  // Alocado via UPDATE ... SET last_sale_number = last_sale_number + 1
  // RETURNING (Prisma `increment`) dentro da mesma transacao de createSale -
  // atomico por construcao (serializa no lock da linha), nunca um SELECT
  // MAX()+1 seguido de INSERT (que sob concorrencia real colidiria com a
  // constraint unica e abortaria a transacao inteira no Postgres sem
  // possibilidade de retry dentro da mesma transacao). Ver
  // src/lib/sales/mutations.ts.
  lastSaleNumber Int @default(0) @map("last_sale_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries          FinancialEntry[]
  categories       Category[]
  recurringEntries RecurringEntry[]
  bills            Bill[]
  recurringBills   RecurringBill[]
  clients          Client[]
  products         Product[]
  sales            Sale[]
  insights         Insight[]
  appointments     Appointment[]

  @@map("businesses")
  insightReads InsightRead[]
}

// Categorias padrao do sistema tem businessId nulo e ficam visiveis para
// todas as empresas; uma empresa pode criar as proprias (businessId
// preenchido). "active" permite desativar sem quebrar lancamentos antigos
// que ja referenciam a categoria.
model Category {
  id             String             @id @default(uuid())
  businessId     String?            @map("business_id")
  business       Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  // Forma canonica de `name` (sem acento, minuscula, espacos colapsados -
  // ver normalizeCategoryName). Persistida (nao so calculada em memoria)
  // para que a constraint UNIQUE abaixo proteja de verdade contra corrida
  // entre duas importacoes simultaneas criando "Frete" e "frete" ao mesmo
  // tempo (Etapa 3.1, secao "Categorias adaptaveis").
  normalizedName String             @map("normalized_name")
  type           FinancialEntryType
  isDefault      Boolean            @default(false) @map("is_default")
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")

  entries          FinancialEntry[]
  recurringEntries RecurringEntry[]
  bills            Bill[]
  recurringBills   RecurringBill[]
  sales            Sale[]
  appointments     Appointment[]

  // So evita duplicata dentro das categorias proprias de uma mesma empresa
  // (businessId preenchido) - Postgres nao trata NULL como igual a NULL, entao
  // isso nao cobre as categorias padrao do sistema; a idempotencia do seed das
  // categorias padrao e garantida no proprio script de seed.
  @@unique([businessId, type, normalizedName])
  @@index([businessId, type])
  @@map("categories")
}

model FinancialEntry {
  id          String             @id @default(uuid())
  businessId  String             @map("business_id")
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FinancialEntryType
  categoryId  String             @map("category_id")
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal            @db.Decimal(14, 2)
  // Dia de calendario do lancamento, no fuso da empresa (Etapa F6; o instante
  // occurredAt saiu na F6d).
  occurredOn  DateTime           @db.Date @map("occurred_on")
  description String
  notes       String?
  source      EntrySource        @default(MANUAL)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Preenchido so em ocorrencias materializadas de um RecurringEntry (Etapa
  // 4.1) - null pra todo lancamento manual/importado, exatamente como hoje.
  // onDelete: SetNull -> excluir o molde desvincula as ocorrencias ja
  // geradas em vez de apaga-las (viram lancamentos avulsos no historico).
  recurringEntryId String?         @map("recurring_entry_id")
  recurringEntry   RecurringEntry? @relation(fields: [recurringEntryId], references: [id], onDelete: SetNull)

  // Dia de calendario da ocorrencia do molde (Etapa F5): identidade da
  // ocorrencia ("a parcela de 20/10"), no fuso da empresa. Preenchido so nas
  // linhas geradas por um RecurringEntry - null em manual/importado/Bill.
  occurrenceDate DateTime? @db.Date @map("occurrence_date")

  // Preenchido quando este lancamento nasceu da confirmacao de pagamento/
  // recebimento de uma Bill (Etapa 5) - null para todo lancamento manual/
  // importado/RECURRING. @unique (nao composto, diferente de
  // recurringEntryId): uma Bill representa UM compromisso, entao so pode
  // gerar NO MAXIMO um lancamento financeiro - a propria constraint garante
  // a idempotencia de "marcar como pago" mesmo sob duplo clique ou
  // requisicoes concorrentes. Reverter o pagamento APAGA este lancamento
  // (revertBillSettlement, na mesma transacao); onDelete: SetNull so cobre a
  // exclusao fisica da Bill, que nenhum fluxo faz com a Bill paga.
  billId String? @unique @map("bill_id")
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  // Chave de idempotencia da materializacao (Etapa 4.1; por DIA desde a F5):
  // NULL e tratado como distinto pelo Postgres, entao essa constraint nunca
  // restringe lancamentos manuais/importados entre si - so impede que o
  // MESMO molde gere duas linhas para o MESMO dia de ocorrencia, mesmo sob
  // duas materializacoes concorrentes ou com o processo em fusos diferentes
  // (ver materializeRecurringEntries).
  @@unique([recurringEntryId, occurrenceDate])
  @@index([businessId, occurredOn])
  @@index([businessId, type])
  @@index([categoryId])
  @@map("financial_entries")
}

// Molde de lancamento recorrente (Etapa 4.1). NUNCA um calculo virtual na
// hora de exibir - so existe pra gerar FinancialEntry reais (materializacao
// preguicosa, ver src/lib/finance/recurring/materialize.ts), que sao os
// unicos registros que calculations.ts/queries.ts/dashboardService.ts
// enxergam. Editar amount/categoria aqui nunca altera ocorrencias ja
// materializadas - so as futuras.
model RecurringEntry {
  id          String             @id @default(uuid())
  businessId  String             @map("business_id")
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        FinancialEntryType
  categoryId  String             @map("category_id")
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal            @db.Decimal(14, 2)
  description String

  frequency RecurrenceFrequency

  // Preenchido conforme frequency; os demais ficam null - validado na
  // aplicacao (mesmo padrao de isIntegerCurrency em finance/schema.ts), o
  // Prisma/Postgres nao tem CHECK cross-column simples aqui.
  dayOfWeek  Int? @map("day_of_week") // WEEKLY: 0=domingo..6=sabado
  dayOfMonth Int? @map("day_of_month") // MONTHLY e YEARLY: 1-31
  yearMonth  Int? @map("year_month") // YEARLY: 0=jan..11=dez

  // Dias de calendario de inicio/fim, no fuso da empresa (Etapa F6c).
  startOn   DateTime  @db.Date @map("start_on")
  endOn     DateTime? @db.Date @map("end_on")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries FinancialEntry[]

  @@index([businessId, isActive])
  @@map("recurring_entries")
}

// Conta a pagar/receber (Etapa 5). Um unico modelo para as duas direcoes - a
// direcao (pagar vs receber) e derivada de category.type (COST/EXPENSE =
// pagar, REVENUE = receber), o mesmo discriminador que FinancialEntry/
// RecurringEntry ja usam, em vez de duas tabelas paralelas (ver ADENDO da
// Etapa 5).
//
// "Atrasado" NUNCA e persistido - e sempre derivado em runtime a partir de
// status===PENDING && dueOn antes de "hoje" no fuso da empresa (ver
// deriveBillStatus em src/lib/finance/bills/status.ts).
model Bill {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String
  amount      Decimal    @db.Decimal(14, 2)
  // INSTANTE de auditoria do pagamento/recebimento (momento real do
  // registro). A logica usa o dia paidOn abaixo; paidAt NULL se e somente se
  // paidOn for NULL.
  paidAt      DateTime?  @map("paid_at")
  status      BillStatus @default(PENDING)

  // Dias de calendario no fuso da empresa (Etapa F6b; as colunas de instante
  // due_date/issue_date sairam na F6d). paidOn e o dia REAL do pagamento -
  // nunca o vencimento: uma conta paga com atraso conta no dia em que foi
  // paga (o occurredOn do FinancialEntry gerado usa paidOn, nao dueOn).
  // - dueOn NAO e occurrenceDate: occurrenceDate (F5) e o dia gerado pela
  //   recorrencia - a identidade da ocorrencia, que nunca muda; dueOn e o
  //   vencimento e acompanha edicoes do usuario. Nao unificar.
  dueOn   DateTime  @db.Date @map("due_on")
  issueOn DateTime? @db.Date @map("issue_on")
  paidOn  DateTime? @db.Date @map("paid_on")

  documentNumber   String? @map("document_number")
  // Fornecedor (contas a pagar) ou cliente (contas a receber) - texto livre
  // (decisao do adendo da Etapa 5): nao ha cadastro de Cliente/Fornecedor no
  // sistema hoje, e criar essas entidades e escopo maior que o pedido nesta
  // etapa.
  counterpartyName String? @map("counterparty_name")
  paymentMethod    String? @map("payment_method")
  bankAccount      String? @map("bank_account")
  costCenter       String? @map("cost_center")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  financialEntry FinancialEntry?

  // Preenchido so em ocorrencias geradas por uma RecurringBill (mesmo padrao
  // de FinancialEntry.recurringEntryId). onDelete: SetNull -> excluir o
  // molde desvincula as ocorrencias ja geradas em vez de apaga-las.
  recurringBillId String?        @map("recurring_bill_id")
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)

  // Dia de calendario da ocorrencia do molde (Etapa F5, mesmo padrao de
  // FinancialEntry.occurrenceDate). Null em toda conta avulsa/parcela.
  occurrenceDate DateTime? @db.Date @map("occurrence_date")

  // Preenchido quando esta Bill representa UMA PARCELA de uma Sale (Etapa 6)
  // - a venda a vista tambem passa por aqui (uma unica Bill, ja PAID). NAO
  // e @unique: uma Sale a prazo gera varias Bills (uma por parcela), ao
  // contrario de FinancialEntry.billId (uma Bill so pode gerar UM
  // lancamento). onDelete: SetNull -> excluir a venda desvincula as parcelas
  // ja geradas em vez de apaga-las (mesmo padrao de recurringBillId).
  saleId String? @map("sale_id")
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  // Chave de idempotencia da materializacao de recorrencia - mesmo padrao de
  // FinancialEntry @@unique([recurringEntryId, occurrenceDate]).
  @@unique([recurringBillId, occurrenceDate])
  @@index([businessId, status])
  @@index([businessId, dueOn])
  @@index([categoryId])
  @@index([saleId])
  @@map("bills")
}

// Molde de conta recorrente (Etapa 5) - aluguel, internet, mensalidade etc.
// Deliberadamente uma entidade separada de RecurringEntry (ver ADENDO da
// Etapa 5): RecurringEntry materializa um FinancialEntry automaticamente ao
// chegar a data (debito automatico certo, sem confirmacao); RecurringBill
// materializa uma Bill PENDENTE, que so vira FinancialEntry quando o usuario
// confirma o pagamento/recebimento. O calculo de datas (frequencia/dia) e
// resolvido reaproveitando as mesmas funcoes puras de
// src/lib/finance/recurring/occurrences.ts (ver
// src/lib/finance/bills/occurrences.ts) - nunca duplica a logica de clamp de
// dia 29/30/31 nem a regra de primeira ocorrencia; BIWEEKLY/QUARTERLY/
// SEMIANNUAL sao resolvidas como multiplos de WEEKLY/MONTHLY sobre essas
// mesmas funcoes, nao como um calculo de calendario novo.
model RecurringBill {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  description String
  amount      Decimal @db.Decimal(14, 2)

  frequency RecurringBillFrequency

  dayOfWeek  Int? @map("day_of_week")
  dayOfMonth Int? @map("day_of_month")
  yearMonth  Int? @map("year_month")

  // Dias de calendario de inicio/fim, no fuso da empresa (Etapa F6b).
  startOn   DateTime  @db.Date @map("start_on")
  endOn     DateTime? @db.Date @map("end_on")
  isActive  Boolean   @default(true) @map("is_active")

  // Copiados para cada Bill gerada na materializacao (mesmo texto livre em
  // todas as ocorrencias do molde) - ver src/lib/finance/bills/materialize.ts.
  documentNumber   String? @map("document_number")
  counterpartyName String? @map("counterparty_name")
  paymentMethod    String? @map("payment_method")
  bankAccount      String? @map("bank_account")
  costCenter       String? @map("cost_center")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bills Bill[]

  @@index([businessId, isActive])
  @@map("recurring_bills")
}

// Cliente (Etapa 6). Deliberadamente generico o suficiente para clientes
// brasileiros, japoneses e de outros paises: `document` e texto livre sem
// validacao de formato (nunca exige CPF/CNPJ), `phone`/`whatsapp` sao texto
// livre (sem mascara de pais fixa). Nunca excluido - "active" (default true)
// e a unica forma de remover um cliente da lista de selecao em novas vendas
// sem apagar o historico (mesmo padrao de Category.active).
model Client {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  tradeName   String?    @map("trade_name")
  clientType  ClientType @default(PESSOA_FISICA) @map("client_type")
  document    String?
  phone       String?
  whatsapp    String?
  email       String?
  addressLine String?    @map("address_line")
  city        String?
  state       String?
  country     String?
  notes       String?
  active      Boolean    @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales        Sale[]
  appointments Appointment[]

  @@index([businessId, active])
  @@index([businessId, name])
  @@map("clients")
}

// PRODUTO (default, nao altera linhas existentes) vs SERVICO (Etapa 8 -
// agenda). Servico exige durationMinutes (validado no Zod, nao aqui) porque
// e usado para calcular o endAt de um AppointmentService no momento da
// criacao do agendamento.
enum ProductType {
  PRODUTO
  SERVICO

  @@map("product_type")
}

// Catalogo minimo de produtos/servicos (Etapa 6) - sem estoque/inventario,
// so o necessario para reaproveitar nome/preco padrao ao lancar itens de
// venda e para o ranking de "Top produtos". `defaultPrice` e so um valor
// sugerido no formulario - SaleItem sempre copia description/unitPrice no
// momento da venda (nunca le o Product de volta depois), mesmo principio de
// RecurringBill -> Bill.
model Product {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  defaultPrice Decimal? @map("default_price") @db.Decimal(14, 2)
  active       Boolean  @default(true)

  // Etapa 8: type/durationMinutes so tem sentido para SERVICO - durationMinutes
  // fica null para PRODUTO (regra de obrigatoriedade e validada no Zod, ver
  // src/lib/products/schema.ts, nao aqui).
  type            ProductType @default(PRODUTO)
  durationMinutes Int?        @map("duration_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  saleItems           SaleItem[]
  appointmentServices AppointmentService[]

  @@index([businessId, active])
  @@map("products")
}

// Venda (Etapa 6). status e SEMPRE o estado comercial (rascunho/confirmada/
// cancelada/concluida) - o status de pagamento nunca e armazenado aqui,
// sempre derivado dos Bills relacionados em tempo de leitura (ver
// deriveSalePaymentStatus em src/lib/sales/status.ts), pelo mesmo motivo que
// BillDisplayStatus.OVERDUE nunca e persistido. `categoryId` deve sempre
// apontar para uma Category type=REVENUE (validado em createSale/updateSale
// via assertCategoryMatches, reaproveitado de finance/mutations.ts) - todo
// Bill gerado por esta venda copia esse mesmo categoryId, nunca um derivado.
model Sale {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Numeracao amigavel sequencial por empresa ("Venda #1025") - alocada via
  // incremento atomico de Business.lastSaleNumber dentro da mesma transacao
  // de criacao (ver src/lib/sales/mutations.ts). @@unique abaixo e so uma
  // invariante passiva: a alocacao atomica ja impede colisao por construcao.
  saleNumber Int        @map("sale_number")
  // Dia de calendario da venda, no fuso da empresa (Etapa F6c).
  saleOn     DateTime   @db.Date @map("sale_on")
  status     SaleStatus @default(CONFIRMED)

  subtotal       Decimal           @db.Decimal(14, 2)
  discountType   SaleDiscountType? @map("discount_type")
  discountValue  Decimal?          @map("discount_value") @db.Decimal(14, 2)
  // Sempre recalculado pelo backend a partir de discountType/discountValue -
  // nunca confia no valor computado pelo frontend.
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(14, 2)
  total          Decimal           @db.Decimal(14, 2)

  paymentMethod String? @map("payment_method")
  notes         String?

  // Idempotencia de criacao (Etapa 6, ADENDO item 4): gerado uma vez no
  // frontend ao abrir o formulario. Duplo clique/retry de rede reencontra a
  // venda ja criada (ver createSale) em vez de duplicar - mesmo principio de
  // duas camadas (check-then-create + constraint como rede de seguranca) que
  // settleBill ja usa para idempotencia de pagamento.
  clientRequestId String @map("client_request_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items       SaleItem[]
  bills       Bill[]
  appointment Appointment? @relation("AppointmentSale")

  // Rastro (Agenda A1): o agendamento DAY cuja conclusao gerou esta venda.
  // Diferente de Appointment.saleId (a venda ATUAL do agendamento, limpa num
  // desfazer), este campo fica na venda mesmo depois de cancelada. Nulo em
  // venda manual e na conclusao TIMED (que nao mudou).
  appointmentId    String?      @map("appointment_id")
  traceAppointment Appointment? @relation("SaleAppointmentTrace", fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([businessId, clientRequestId])
  @@unique([businessId, saleNumber])
  @@index([businessId, saleOn])
  @@index([businessId, status])
  @@index([clientId])
  @@index([appointmentId])
  @@map("sales")
}

// Item de uma venda (Etapa 6). `description`/`unitPrice` sao SEMPRE copiados
// no momento da venda (a partir do Product escolhido ou digitados livremente)
// - nunca lidos de volta do Product depois, entao renomear/repreçar um
// Product nao altera vendas passadas (mesmo principio de RecurringBill ->
// Bill). `lineTotal` e sempre recalculado pelo backend (quantity * unitPrice),
// nunca confia no valor computado pelo frontend.
model SaleItem {
  id        String   @id @default(uuid())
  saleId    String   @map("sale_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description String
  // Decimal (nao Int) porque a quantidade pode ser fracionaria (kg, horas
  // etc.). Para moeda sem casas decimais (JPY), a validacao em
  // src/lib/sales/schema.ts exige quantity inteira tambem, para que
  // quantity * unitPrice nunca produza um valor fracionario de iene mesmo
  // com unitPrice inteiro.
  quantity    Decimal @db.Decimal(14, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// Insight (Etapa 7) - uma linha por (empresa, periodo, metrica), upsert
// idempotente via @@unique abaixo. Nunca guarda FK para Sale/Bill/
// FinancialEntry: referencia numeros ja agregados (currentValue/
// previousValue), nao linhas individuais - o modelo fica estavel mesmo que o
// schema financeiro subjacente evolua. currentValue/previousValue sao
// nullable porque nem toda metrica e um valor monetario simples (ex.:
// CLIENT_INACTIVITY guarda a lista de clientes na propria description/
// recommendation, ja formatada, em vez de um unico numero).
model Insight {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // "yyyy-mm" - granularidade mensal apenas na v1 (secao "Decisoes" da Etapa
  // 7). Comparacoes trimestrais/anuais ficam para uma etapa futura.
  periodKey String          @map("period_key")
  category  InsightCategory
  metric    InsightMetric
  priority  InsightPriority

  // Sempre texto completo e pronto para renderizar (title/description/
  // recommendation), deterministico (rules.ts) ou validado pela IA
  // (narrative.ts) - nunca montado no lado do cliente a partir de partes.
  title          String
  description    String
  recommendation String?

  periodStart           DateTime  @map("period_start")
  periodEnd             DateTime  @map("period_end")
  // Nulos quando hasPreviousPeriod for false (inicio frio) - nenhuma metrica
  // comparativa e gerada nesse caso.
  comparisonPeriodStart DateTime? @map("comparison_period_start")
  comparisonPeriodEnd   DateTime? @map("comparison_period_end")

  currentValue      Decimal?       @map("current_value") @db.Decimal(14, 2)
  previousValue     Decimal?       @map("previous_value") @db.Decimal(14, 2)
  variationAbsolute Decimal?       @map("variation_absolute") @db.Decimal(14, 2)
  variationPercent  Decimal?       @map("variation_percent") @db.Decimal(7, 4)
  variationKind     VariationKind? @map("variation_kind")

  // Qual modulo forneceu os numeros subjacentes ("financeiro" | "vendas" |
  // "contas_a_receber") - auditoria/depuracao, nunca lido por rules.ts.
  source          String
  // "template" (rules.ts, sempre correto) ou "ai" (narrative.ts, so depois
  // de passar na checagem de whitelist numerica) - qual caminho de fato
  // produziu description/recommendation.
  narrativeSource String @map("narrative_source")
  // Fingerprint barato (count + max(updatedAt) de FinancialEntry no
  // periodo) usado por getInsightsForBusiness para decidir se este cache
  // esta desatualizado - ver src/lib/insights/mutations.ts.
  dataFingerprint String @map("data_fingerprint")

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Upsert idempotente: regenerar um periodo nunca acumula linhas, sempre
  // substitui a existente para aquela metrica.
  @@unique([businessId, periodKey, metric])
  @@index([businessId, periodKey])
  @@index([businessId, priority])
  @@map("insights")
}

// Estado de leitura dos insights POR USUARIO. A chave do insight e deterministica e
// estavel entre recalculos: "<metrica em minusculas>:<periodo yyyy-mm>" (ex.:
// "expense_growth:2026-11") - nao e o id da linha de insights (que muda se a metrica
// deixa de disparar e volta). Existir uma linha = lido; apagar = nao lido. Unico por
// usuario + empresa + chave (marcar duas vezes e idempotente).
model InsightRead {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  insightKey String   @map("insight_key")
  readAt     DateTime @default(now()) @map("read_at")

  @@unique([userId, businessId, insightKey])
  @@index([businessId])
  @@map("insight_reads")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // Teto absoluto da sessao - calculado UMA VEZ na criacao
  // (ABSOLUTE_SESSION_DAYS_DEFAULT ou _REMEMBERED, conforme "lembrar de
  // mim" no login) e nunca estendido depois. Antes da Etapa
  // sessao-expiracao-reauth este campo era renovado a cada uso (renovacao
  // deslizante) - removido porque uma sessao em uso continuo nunca
  // expirava de verdade, o que contradiz a garantia de teto absoluto.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Expiracao por inatividade: atualizado a cada requisicao autenticada
  // validada, mas no maximo 1x a cada ACTIVITY_UPDATE_THROTTLE_MINUTES
  // (ver sessionPolicy.ts) para nao gravar no banco a toda chamada de API.
  // Se (agora - lastActivityAt) > INACTIVITY_TIMEOUT_MINUTES, a sessao e
  // tratada como expirada mesmo com expiresAt ainda no futuro.
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  // Reautenticacao para acoes sensiveis (step-up/"sudo mode"): setado ao
  // confirmar a senha em POST /api/auth/reauth, valido por
  // STEP_UP_GRACE_MINUTES. Nulo ou no passado = sessao nao elevada.
  elevatedUntil DateTime? @map("elevated_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Estado do agendamento (Etapa 8). CONCLUIDO e sempre terminal - mesmo se a
// Sale vinculada for cancelada depois (ver cancelSale em sales/mutations.ts),
// o agendamento NUNCA volta a AGENDADO/CONFIRMADO por causa disso; a UI so
// deriva e mostra "venda cancelada" a partir do status da Sale (mesmo
// principio de derivar em vez de duplicar estado ja usado em
// deriveSalePaymentStatus). CANCELADO/FALTOU podem reabrir para AGENDADO
// (decisao aprovada da Etapa 8 - toque errado na lista de acoes rapidas e um
// cenario realista); a tabela exaustiva de pares permitidos vive em
// src/lib/agenda/calculations.ts (canTransition), nunca "solta" pela app.
enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  FALTOU

  @@map("appointment_status")
}

// Fluxo do agendamento (Agenda A1). TIMED = o fluxo original da Etapa 8
// (horario de inicio/fim, conclusao manual com modal); todo agendamento que
// ja existia e TIMED e nao muda de comportamento. DAY = o fluxo novo do plano
// (secao 4): so o dia (scheduledOn), sem horario, com servicos, valores,
// categoria e pagamento ja definidos na criacao - e o que permite concluir
// sem perguntar nada (conclusao automatica no Prompt 4).
enum AppointmentKind {
  TIMED
  DAY

  @@map("appointment_kind")
}

// Condicao de pagamento do fluxo DAY, nas mesmas condicoes que o app ja tem:
// AVISTA = uma parcela paga no dia do atendimento; APRAZO = as parcelas de
// AppointmentInstallment, todas pendentes.
enum PaymentTiming {
  AVISTA
  APRAZO

  @@map("payment_timing")
}

// Agendamento (Etapa 8). startAt/endAt sao SEMPRE UTC - exibicao e limites de
// dia/semana/mes sao resolvidos exclusivamente por src/lib/agenda/time.ts
// (fuso Asia/Tokyo fixo, nunca o fuso local do host - ver limitacao ja
// documentada em finance/period.ts, que esta etapa deliberadamente NAO
// repete). endAt e sempre recalculado a partir dos AppointmentService no
// momento da criacao/remarcacao (ver computeEndAt) - nunca editado
// diretamente.
//
// saleId e preenchido so quando o atendimento e concluido (ver
// completeAppointment) - a Sale e criada reaproveitando createSale (Etapa 6)
// dentro da MESMA transacao (ver "Decisao aberta #4" do plano). onDelete:
// Restrict tanto em clientId quanto em saleId (mesmo principio de
// Sale.clientId): nenhum dos dois e apagado fisicamente por nenhum caminho
// de app hoje (so em teardown de teste, que cascateia Client/Sale/Appointment
// juntos a partir do Business - RESTRICT e NO ACTION se comportam identico
// aqui, sem constraint DEFERRABLE em lugar nenhum do projeto), entao Restrict
// so bloqueia mesmo uma exclusao direta no banco que deixaria o agendamento
// com o link quebrado.
model Appointment {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Anulavel desde o agendamento DAY SEM VALOR (ex.: reuniao), que nao exige
  // cliente. TIMED continua sempre com cliente - CHECK
  // appointments_timed_client_check.
  clientId   String?  @map("client_id")
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  // Titulo curto opcional (ate 120 caracteres, validado no Zod), identificacao
  // principal na lista quando existe. Todo DAY precisa de ao menos um entre
  // cliente, servico e titulo (regra do servidor: depende das linhas de servico).
  title      String?

  // Agenda A1: anulaveis desde o fluxo DAY (que nao tem horario). TIMED
  // continua sempre preenchendo os dois - garantido no banco pela CHECK
  // appointments_timed_fields_check (ver migracao agenda_day_flow).
  startAt DateTime?         @map("start_at")
  endAt   DateTime?         @map("end_at")
  status  AppointmentStatus @default(AGENDADO)
  notes   String?

  // Fluxo (Agenda A1). Campos abaixo so tem sentido em DAY: o dia do
  // atendimento (sem horario, no fuso da empresa - convencao _on da F6),
  // obrigatorio (CHECK appointments_day_fields_check), e a categoria de receita
  // da venda e a condicao de pagamento, que ou vem os dois ou nenhum (CHECK
  // appointments_payment_coherence_check). Um DAY COM valor (> 0) exige os dois
  // (regra do servidor, pois o total depende das linhas de servico); um DAY
  // SEM valor (total zero) os deixa nulos. TIMED deixa todos nulos (a conclusao
  // TIMED pergunta categoria/pagamento no modal).
  kind          AppointmentKind @default(TIMED)
  scheduledOn   DateTime?       @db.Date @map("scheduled_on")
  categoryId    String?         @map("category_id")
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentTiming PaymentTiming?  @map("payment_timing")
  paymentMethod String?         @map("payment_method") // PAYMENT_METHOD_OPTIONS

  // Pode ser concluido automaticamente (gatilho no Prompt 4)? true na criacao
  // DAY; false PARA SEMPRE depois de qualquer desfazer, cancelamento, falta
  // ou reabertura (nunca volta a true). TIMED: sempre false.
  autoCompleteEligible Boolean @default(false) @map("auto_complete_eligible")
  // Quantas vezes a conclusao foi desfeita: entra no clientRequestId da venda
  // da conclusao DAY ("agenda:<id>:<seq>"), para que reconcluir depois de um
  // desfazer crie uma venda NOVA em vez de reaproveitar a cancelada.
  completionSeq        Int     @default(0) @map("completion_seq")

  // Preenchidos so na transicao correspondente (ver changeAppointmentStatus/
  // completeAppointment) - nunca os dois ao mesmo tempo, e cancelledAt e
  // limpo de novo se o agendamento for reaberto (CANCELADO/FALTOU ->
  // AGENDADO).
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  // @unique: um agendamento gera no maximo UMA Sale - segunda linha de defesa
  // de idempotencia de completeAppointment (a primeira e o updateMany
  // condicional no status de origem, ver mutations.ts).
  saleId String? @unique @map("sale_id")
  sale   Sale?   @relation("AppointmentSale", fields: [saleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services     AppointmentService[]
  installments AppointmentInstallment[]
  // Vendas geradas por conclusoes DAY deste atendimento (Sale.appointmentId,
  // rastro que sobrevive a um desfazer - saleId acima e so a venda atual).
  tracedSales  Sale[]                   @relation("SaleAppointmentTrace")

  @@index([businessId, startAt])
  @@index([businessId, clientId, startAt])
  @@index([businessId, status, startAt])
  @@index([businessId, scheduledOn])
  @@index([businessId, kind, status, scheduledOn])
  @@map("appointments")
}

// Parcelas PLANEJADAS de um agendamento DAY a prazo (Agenda A1, plano 4.1):
// viram as parcelas (Bill) da venda na conclusao. A vista nao usa esta
// tabela - a unica parcela e o proprio dia do atendimento, paga. Mesmas
// regras de validacao das parcelas de venda (soma = total, inteiro em JPY,
// vencimento >= dia do atendimento), aplicadas na criacao.
model AppointmentInstallment {
  id            String      @id @default(uuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  position Int
  dueOn    DateTime @db.Date @map("due_on")
  amount   Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([appointmentId, position])
  @@map("appointment_installments")
}

// Servicos de um agendamento (Etapa 8). name/durationMinutes sao SEMPRE
// copiados do Product no momento da criacao (nunca lidos de volta depois) -
// mesmo principio de SaleItem.description/unitPrice e RecurringBill -> Bill:
// editar um Product depois nao move agendamentos ja criados. productId e
// opcional (onDelete: SetNull) porque nao ha exclusao fisica de Product hoje,
// mas mantem o mesmo padrao de SaleItem.productId por consistencia.
//
// @@unique(appointmentId, position): ao editar servicos, o fluxo e sempre
// deleteMany (tudo) seguido de createMany (tudo de novo) na mesma transacao -
// nunca insere por cima do conjunto antigo - entao a constraint nunca ve dois
// registros com o mesmo par ao mesmo tempo.
model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productId     String?     @map("product_id")
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  nameSnapshot            String @map("name_snapshot")
  // Anulavel desde a Agenda A1: so TIMED usa duracao (para calcular endAt).
  durationMinutesSnapshot Int?   @map("duration_minutes_snapshot")
  position                Int

  // Valor do servico neste agendamento DAY (Agenda A1): snapshot do
  // Product.defaultPrice, editavel na criacao, nunca relido do Product. Total
  // do agendamento = soma de unitPrice * quantity (derivado, nunca gravado).
  // TIMED deixa nulo (o preco sai do modal de conclusao).
  unitPrice Decimal? @map("unit_price") @db.Decimal(14, 2)
  quantity  Int      @default(1)

  @@unique([appointmentId, position])
  @@index([productId])
  @@map("appointment_services")
}
