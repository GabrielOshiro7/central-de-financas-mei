generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  resetTokens      PasswordResetToken[]
  business         Business?
  financialEntries FinancialEntry[]

  @@map("users")
}

enum BusinessType {
  RESTAURANTE
  LOJA
  SERVICOS
  CONSTRUCAO
  ECOMMERCE
  ACADEMIA
  OUTRO

  @@map("business_type")
}

enum YearsInBusiness {
  MENOS_DE_1_ANO
  DE_1_A_3_ANOS
  DE_3_A_5_ANOS
  DE_5_A_10_ANOS
  MAIS_DE_10_ANOS

  @@map("years_in_business")
}

enum Currency {
  JPY
  BRL
  USD

  @@map("currency")
}

enum FinancialEntryType {
  REVENUE
  COST
  EXPENSE

  @@map("financial_entry_type")
}

enum EntrySource {
  MANUAL
  IMPORT
  RECURRING

  @@map("entry_source")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("recurrence_frequency")
}

model Business {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                  String?
  businessType          BusinessType?    @map("business_type")
  revenueModel          String[]         @map("revenue_model")
  revenueModelOther     String?          @map("revenue_model_other")
  yearsInBusiness       YearsInBusiness? @map("years_in_business")
  employeeCount         Int?             @map("employee_count")
  // Nunca inferida por locale/navegador/header - sempre escolha explicita do
  // usuario no onboarding (ou editada em /empresa). Default BRL so serve
  // para linhas que ja existiam antes desse campo virar obrigatorio (ver
  // migration) e para negocios que ainda nao terminaram o onboarding.
  // Trocar depois de a empresa ja ter lancamentos e bloqueado na API (secao
  // "Bug 1" da Etapa 3.1) - nesta etapa nao ha conversao/cambio retroativo.
  currency              Currency         @default(BRL)
  averageMonthlyRevenue Decimal?         @map("average_monthly_revenue") @db.Decimal(14, 2)

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep      Int     @default(1) @map("onboarding_step")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries         FinancialEntry[]
  categories      Category[]
  recurringEntries RecurringEntry[]

  @@map("businesses")
}

// Categorias padrao do sistema tem businessId nulo e ficam visiveis para
// todas as empresas; uma empresa pode criar as proprias (businessId
// preenchido). "active" permite desativar sem quebrar lancamentos antigos
// que ja referenciam a categoria.
model Category {
  id             String             @id @default(uuid())
  businessId     String?            @map("business_id")
  business       Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  // Forma canonica de `name` (sem acento, minuscula, espacos colapsados -
  // ver normalizeCategoryName). Persistida (nao so calculada em memoria)
  // para que a constraint UNIQUE abaixo proteja de verdade contra corrida
  // entre duas importacoes simultaneas criando "Frete" e "frete" ao mesmo
  // tempo (Etapa 3.1, secao "Categorias adaptaveis").
  normalizedName String             @map("normalized_name")
  type           FinancialEntryType
  isDefault      Boolean            @default(false) @map("is_default")
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at")

  entries         FinancialEntry[]
  recurringEntries RecurringEntry[]

  // So evita duplicata dentro das categorias proprias de uma mesma empresa
  // (businessId preenchido) - Postgres nao trata NULL como igual a NULL, entao
  // isso nao cobre as categorias padrao do sistema; a idempotencia do seed das
  // categorias padrao e garantida no proprio script de seed.
  @@unique([businessId, type, normalizedName])
  @@index([businessId, type])
  @@map("categories")
}

model FinancialEntry {
  id          String             @id @default(uuid())
  businessId  String             @map("business_id")
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String             @map("user_id")
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FinancialEntryType
  categoryId  String             @map("category_id")
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal            @db.Decimal(14, 2)
  occurredAt  DateTime           @map("occurred_at")
  description String
  notes       String?
  source      EntrySource        @default(MANUAL)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Preenchido so em ocorrencias materializadas de um RecurringEntry (Etapa
  // 4.1) - null pra todo lancamento manual/importado, exatamente como hoje.
  // onDelete: SetNull -> excluir o molde desvincula as ocorrencias ja
  // geradas em vez de apaga-las (viram lancamentos avulsos no historico).
  recurringEntryId String?         @map("recurring_entry_id")
  recurringEntry   RecurringEntry? @relation(fields: [recurringEntryId], references: [id], onDelete: SetNull)

  @@index([businessId, occurredAt])
  @@index([businessId, type])
  @@index([categoryId])
  // Chave de idempotencia da materializacao (secao "MATERIALIZACAO" da Etapa
  // 4.1): NULL e tratado como distinto pelo Postgres, entao essa constraint
  // nunca restringe lancamentos manuais/importados entre si - so impede que
  // o MESMO molde gere duas linhas para a MESMA data de ocorrencia, mesmo
  // sob duas materializacoes concorrentes (ver materializeRecurringEntries).
  @@unique([recurringEntryId, occurredAt])
  @@map("financial_entries")
}

// Molde de lancamento recorrente (Etapa 4.1). NUNCA um calculo virtual na
// hora de exibir - so existe pra gerar FinancialEntry reais (materializacao
// preguicosa, ver src/lib/finance/recurring/materialize.ts), que sao os
// unicos registros que calculations.ts/queries.ts/dashboardService.ts
// enxergam. Editar amount/categoria aqui nunca altera ocorrencias ja
// materializadas - so as futuras.
model RecurringEntry {
  id          String             @id @default(uuid())
  businessId  String             @map("business_id")
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        FinancialEntryType
  categoryId  String             @map("category_id")
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount      Decimal            @db.Decimal(14, 2)
  description String

  frequency RecurrenceFrequency

  // Preenchido conforme frequency; os demais ficam null - validado na
  // aplicacao (mesmo padrao de isIntegerCurrency em finance/schema.ts), o
  // Prisma/Postgres nao tem CHECK cross-column simples aqui.
  dayOfWeek  Int? @map("day_of_week") // WEEKLY: 0=domingo..6=sabado
  dayOfMonth Int? @map("day_of_month") // MONTHLY e YEARLY: 1-31
  yearMonth  Int? @map("year_month") // YEARLY: 0=jan..11=dez

  // Sempre meia-noite local (mesmo fuso ja documentado em period.ts) - as
  // ocorrencias materializadas usam essa mesma convencao de horario, exigido
  // pra constraint de unicidade acima pegar duplicata de forma confiavel.
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entries FinancialEntry[]

  @@index([businessId, isActive])
  @@map("recurring_entries")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
